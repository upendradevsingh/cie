# CIE — Conversation Intelligence Engine
# Copy this to .env and fill in your values

# App
APP_NAME=CIE
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql://cie:cie@localhost:5432/cie

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (shared secret from calling service — must match issuer's secret)
JWT_SECRET=your-shared-jwt-secret-here
JWT_ALGORITHM=HS256

# Transcription
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=your-deepgram-api-key

# LLM
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4o

# Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=100

# S3 (optional — leave blank for local storage)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS
CORS_ORIGINS=["*"]
