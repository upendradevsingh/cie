# ============================================================================
# SalesLens Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required keys are marked with [REQUIRED]. Everything else has sensible
# defaults that work out of the box with docker-compose.
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=SalesLens
APP_VERSION=0.1.0
DEBUG=false

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. The default works with the docker-compose
# postgres service. Change host to "localhost" when running outside Docker.
DATABASE_URL=postgresql://saleslens:saleslens_password@postgres:5432/saleslens

# ── Redis ───────────────────────────────────────────────────────────────────
# Used as Celery broker and result backend. The default works with the
# docker-compose redis service.
REDIS_URL=redis://redis:6379/0

# ── Security / JWT ──────────────────────────────────────────────────────────
# [REQUIRED] Change this to a random string of at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# ── Transcription ───────────────────────────────────────────────────────────
# Provider for speech-to-text. Options: deepgram, whisper
TRANSCRIPTION_PROVIDER=deepgram

# [REQUIRED] Deepgram Nova-3 API key. Sign up at https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# [REQUIRED] OpenAI API key. Used for Whisper fallback transcription AND
# LLM-based call analysis. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ── LLM Analysis ───────────────────────────────────────────────────────────
# Provider and model for the call analysis pipeline.
LLM_PROVIDER=openai
# Primary model for bulk analysis. Options: gpt-4o-mini, gpt-4o
LLM_MODEL=gpt-4o-mini
# QA sample model for quality auditing (optional, defaults to gpt-4o)
LLM_QA_MODEL=gpt-4o

# ── File Storage ────────────────────────────────────────────────────────────
# Local directory for uploaded call recordings. Inside Docker this is
# mounted as a named volume.
UPLOAD_DIR=/app/uploads
# Maximum file size for uploaded recordings in megabytes.
MAX_FILE_SIZE_MB=100

# ── S3 Storage (optional) ──────────────────────────────────────────────────
# Leave S3_BUCKET empty to use local filesystem storage. When set, all
# recordings are stored in S3 at s3://{bucket}/{tenant_id}/{uuid}.{ext}.
# Celery workers will download from S3 or use presigned URLs.
S3_BUCKET=
# AWS region for the bucket (e.g., ap-south-1, us-east-1)
S3_REGION=
# IAM credentials. On EC2 with an instance role these can be left empty —
# boto3 will use the instance metadata service automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: custom endpoint for S3-compatible services (e.g., MinIO)
S3_ENDPOINT_URL=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for browser requests. The defaults
# cover the Vite dev server and the Docker frontend service.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email / SMTP (optional) ────────────────────────────────────────────────
# Configure these to enable weekly report emails. Leave empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
REPORT_FROM_EMAIL=reports@saleslens.ai

# ── Celery ──────────────────────────────────────────────────────────────────
# Advanced Celery configuration. Defaults are fine for most deployments.
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=600    # 10 minutes per task soft limit
CELERY_TASK_TIME_LIMIT=900         # 15 minutes per task hard limit

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text
